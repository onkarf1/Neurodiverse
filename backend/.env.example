# Copy to .env and fill in values. Never commit .env.

# Required: development, test, or production. There is no default.
APP_ENV=development
# DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
MAX_REQUEST_BODY_BYTES=1048576

# Required, at least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Optional token and password settings (defaults shown).
# JWT_ISSUER=goalfit-api
# JWT_AUDIENCE=goalfit-web
# ACCESS_TOKEN_TTL_MINUTES=30
# Simultaneous password hashes per process; each uses 64 MiB (2 x 64 MiB = 128 MiB).
# PASSWORD_HASH_CONCURRENCY=2
# Logins allowed to wait for a hash; beyond this they are refused immediately.
# PASSWORD_HASH_QUEUE_LIMIT=32

DATABASE_URL=postgresql+asyncpg://goalfit:goalfit@localhost:5432/goalfit
# Optional connection pool tuning (defaults shown). Per API process, at most
# DB_POOL_SIZE + DB_MAX_OVERFLOW connections, plus 1 short-lived readiness check.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_SECONDS=10
# DB_CONNECT_TIMEOUT_SECONDS=5
# DB_STATEMENT_TIMEOUT_MS=5000
# READINESS_TIMEOUT_SECONDS=2
# Tests only; the database name must end in _test.
# TEST_DATABASE_URL=postgresql+asyncpg://goalfit:goalfit@localhost:5432/goalfit_test
REDIS_URL=redis://localhost:6379/0

AI_BASE_URL=https://openai.rc.asu.edu/v1
AI_MODEL=qwen3-235b-a22b-instruct-2507
# AI_TIMEOUT_SECONDS=30
# Needed from BE-6 onward. Create a key in the ASU Voyager portal.
# ASU_AIR_API_KEY=

# Optional passwords for `python -m app.cli seed-demo` (15 to 128 characters).
# DEMO_ADMIN_PASSWORD=
# DEMO_TEACHER_PASSWORD=
