# Copy to .env (git-ignored) and fill in the key to turn on AI assistance.
# Without a key, StriveTrack uses its local rules and works fully offline.
STRIVETRACK_AI_API_KEY=
STRIVETRACK_AI_BASE_URL=https://openai.rc.asu.edu/v1
STRIVETRACK_AI_MODEL=qwen3-30b-a3b
# Other OpenAI-compatible model names also work (slower in testing), for example:
# STRIVETRACK_AI_MODEL=muse-glimmer-30b

# Optional shell overrides:
# STRIVETRACK_PYTHON=python3.12
# Backend default: http://127.0.0.1:8001
# Frontend default: http://127.0.0.1:5173
# To bypass the Vite proxy (normally unnecessary):
# VITE_API_URL=http://127.0.0.1:8001/api
